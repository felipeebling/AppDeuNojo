<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TelaAnuncie">
    <TextView
        android:id="@+id/tvAnuncieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Novo Anúncio"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spCategoria"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvAnuncieTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Título do Anúncio"
        app:layout_constraintTop_toBottomOf="@id/spCategoria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etPreco"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Preço (R$)"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/etTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Descrição do produto"
        android:minLines="3"
        android:gravity="top"
        app:layout_constraintTop_toBottomOf="@id/etPreco"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etContato"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Contato (Telefone / WhatsApp)"
        android:inputType="phone"
        app:layout_constraintTop_toBottomOf="@id/etDescricao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etSituacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Situação (Novo, Usado, etc.)"
        app:layout_constraintTop_toBottomOf="@id/etContato"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnSalvarAnuncio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Salvar Anúncio"
        app:layout_constraintTop_toBottomOf="@id/etSituacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />
</androidx.constraintlayout.widget.ConstraintLayout>